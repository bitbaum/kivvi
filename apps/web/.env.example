# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/kivvi

# NextAuth.js configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# AI Provider configuration
# Users can select models from the UI - these are the API keys for each provider

# OpenRouter - Provides free models (recommended for starting)
# Get your free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Anthropic (optional - for Claude models)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Ollama - Self-hosted models (optional - requires local setup)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Use Neon serverless driver
# USE_NEON=true

# Email configuration (Brevo SMTP)
# Get your SMTP credentials from https://app.brevo.com/settings/keys/smtp
# Note: Since kivvi.vercel.app can't be verified, use revamp-it.ch domain
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-brevo-login-email
EMAIL_PASS=your-brevo-smtp-key
EMAIL_FROM=noreply@revamp-it.ch
