{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "paths": {
      "@kivvi/core": ["../core/src"],
      "@kivvi/core/*": ["../core/*"],
      "@kivvi/database": ["../database/src"],
      "@kivvi/database/*": ["../database/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
