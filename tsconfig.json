{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@kivvi/core": ["packages/core/src"],
      "@kivvi/database": ["packages/database/src"],
      "@kivvi/ai": ["packages/ai/src"],
      "@kivvi/events": ["packages/events/src"],
      "@kivvi/ui": ["packages/ui/src"]
    }
  },
  "exclude": ["node_modules"]
}
