# Database
DATABASE_URL="postgresql://kivvi:kivvi_dev@localhost:5432/kivvi"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-32-character-secret-here"

# AI Providers (configure at least one)
# Priority: Groq → xAI → OpenRouter → Ollama → Anthropic

# Groq (free tier, fastest inference — get key at console.groq.com)
GROQ_API_KEY=""

# xAI Grok (free tier available)
XAI_API_KEY=""

# Anthropic Claude (recommended for best quality)
ANTHROPIC_API_KEY=""

# OpenAI (alternative)
OPENAI_API_KEY=""

# OpenRouter (access multiple models, free tier available)
OPENROUTER_API_KEY=""

# Ollama (self-hosted, no API key needed)
OLLAMA_BASE_URL="http://localhost:11434"

# Optional: Redis for caching
REDIS_URL="redis://localhost:6379"

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# Only needed to sell the hosted Cloud plan. Self-hosted Kivvi ignores all
# three: the billing settings page still renders, but checkout is unavailable.

# Secret key from dashboard.stripe.com/apikeys (sk_test_... / sk_live_...).
# Absent, /settings/billing throws when a checkout or portal session is opened.
STRIPE_SECRET_KEY=""

# Price ID of the recurring Cloud plan (CHF 49/mo), NOT the product ID —
# Products → your product → Pricing → the price's API ID. Starts with "price_".
# Absent, "Upgrade" fails with errorStripePriceNotConfigured.
STRIPE_PRICE_ID=""

# Signing secret for the /api/webhooks/stripe endpoint (starts with "whsec_").
# Create the endpoint under Developers → Webhooks and subscribe it to:
#   checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted, invoice.payment_failed
# Absent, the endpoint 500s and a paid subscription never flips the company
# to premium — Stripe takes the money and Kivvi never hears about it.
STRIPE_WEBHOOK_SECRET=""
